# Copy to .env.local and fill in. Never commit the filled-in file.
# Same service account and workbook as batch-dos-reunion.

# GOOGLE_PRIVATE_KEY keeps its literal \n escapes — paste it exactly as it appears
# in the JSON, wrapped in double quotes.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=""

# The reunion workbook. RSVPs go to its "RSVP" tab, created on the first response.
SHEET_ID=
